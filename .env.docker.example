# Docker environment configuration template.
# Copy to .env.docker and customize values.

# Application
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:3000

# MongoDB
MONGO_DATABASE=authboiler
MONGO_USERNAME=admin
MONGO_PASSWORD=your-mongo-password
MONGO_URI=mongodb://mongodb:27017/authboiler

# Rate limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=60

# SMTP
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=user@example.com
SMTP_PASS=your-smtp-password
EMAIL_FROM=noreply@example.com

# Bcrypt
BCRYPT_ROUNDS=10

# Session
SESSION_COOKIE_NAME=sid
SESSION_COOKIE_MAX_AGE=604800000

# Activation codes
ACTIVATION_CODE_EXPIRES_IN=900000
ACTIVATION_MAX_ATTEMPTS=5

# Password sign-in
AUTH_PASSWORD_ENABLED=true

# Magic link sign-in - needs SMTP_HOST and EMAIL_FROM
MAGIC_LINK_ENABLED=true
# Magic link lifetime in milliseconds
MAGIC_LINK_EXPIRES_IN=900000
# Magic links mailed to one address per hour
MAGIC_LINK_MAX_PER_HOUR=5

# TOTP two-factor - see docs/setup-two-factor.md
TWO_FACTOR_ENABLED=true
# 32 bytes of base64, from `openssl rand -base64 32`. Required before any
# account can turn a second factor on. Changing it locks out every enrolled app.
TOTP_ENCRYPTION_KEY=

# Passkeys (WebAuthn) - see docs/setup-passkeys.md
PASSKEYS_ENABLED=true
# Domain the credentials are bound to, a bare hostname with no scheme and no
# port. Defaults to the hostname of CLIENT_URL. Changing it invalidates every
# passkey already registered.
WEBAUTHN_RP_ID=
# Name shown in the browser prompt. Defaults to the app name.
WEBAUTHN_RP_NAME=
# Origin the browser has to be on. Defaults to the origin of CLIENT_URL, and
# has to be https outside localhost.
WEBAUTHN_ORIGIN=

# Swagger
SWAGGER_ENABLED=false

# Google OAuth
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_GOOGLE_CALLBACK_URL=http://localhost:3000/auth/oauth/callback/google

# Facebook OAuth
OAUTH_FACEBOOK_CLIENT_ID=
OAUTH_FACEBOOK_CLIENT_SECRET=
OAUTH_FACEBOOK_CALLBACK_URL=http://localhost:3000/auth/oauth/callback/facebook

# GitHub OAuth
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=
OAUTH_GITHUB_CALLBACK_URL=http://localhost:3000/auth/oauth/callback/github

# Microsoft OAuth
OAUTH_MICROSOFT_CLIENT_ID=
OAUTH_MICROSOFT_CLIENT_SECRET=
OAUTH_MICROSOFT_CALLBACK_URL=http://localhost:5000/api/auth/oauth/microsoft/callback
OAUTH_MICROSOFT_TENANT=common

# Apple OAuth
# Apple refuses localhost redirect URIs. Point the callback at an HTTPS host.
# The private key is the .p8 file on one line, with newlines written as \n.
OAUTH_APPLE_CLIENT_ID=
OAUTH_APPLE_CALLBACK_URL=
OAUTH_APPLE_TEAM_ID=
OAUTH_APPLE_KEY_ID=
OAUTH_APPLE_PRIVATE_KEY=

# Discord OAuth
OAUTH_DISCORD_CLIENT_ID=
OAUTH_DISCORD_CLIENT_SECRET=
OAUTH_DISCORD_CALLBACK_URL=http://localhost:5000/api/auth/oauth/discord/callback

# LinkedIn OAuth
OAUTH_LINKEDIN_CLIENT_ID=
OAUTH_LINKEDIN_CLIENT_SECRET=
OAUTH_LINKEDIN_CALLBACK_URL=http://localhost:5000/api/auth/oauth/linkedin/callback

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:5000
