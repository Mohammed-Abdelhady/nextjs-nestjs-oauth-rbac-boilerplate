# Environment Configuration Template
# Copy this file to .env and fill in your actual values

# Application Environment
# Options: development, production, test
NODE_ENV=development

# Server Port
# Default: 5001
PORT=5001

# MongoDB Connection URI
# Local: mongodb://localhost:27017/authboiler
# Atlas: mongodb+srv://username:password@cluster.mongodb.net/database
MONGO_URI=mongodb://localhost:27017/authboiler

# Frontend URL (for CORS)
# Local: http://localhost:3000
# Production: https://yourdomain.com
CLIENT_URL=http://localhost:3000

# Rate Limiting Configuration
# TTL: Time window in seconds (default: 60)
# Limit: Max requests per TTL (default: 60)
THROTTLE_TTL=60
THROTTLE_LIMIT=60

# SMTP Configuration (for sending emails)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
# EMAIL_FROM=your-email@gmail.com

# Bcrypt Configuration
# Number of rounds for password hashing (default: 10, range: 4-12)
BCRYPT_ROUNDS=10

# Session Configuration
# Cookie name for session token (default: sid)
SESSION_COOKIE_NAME=sid
# Cookie max age in milliseconds (default: 604800000 = 7 days)
SESSION_COOKIE_MAX_AGE=604800000

# Activation Code Configuration
# Code expiry time in milliseconds (default: 900000 = 15 minutes)
ACTIVATION_CODE_EXPIRES_IN=900000
# Maximum activation attempts before code invalidation (default: 5)
ACTIVATION_MAX_ATTEMPTS=5

# Profile Synchronization
# Enable automatic profile synchronization from OAuth providers (default: true)
PROFILE_SYNC_ENABLED=true
# Profile fields to sync from OAuth providers (default: name,picture)
PROFILE_SYNC_FIELDS=name,picture

# OAuth Configuration (all providers are optional)
# A provider is auto-enabled once its CLIENT_ID and CLIENT_SECRET are set. CALLBACK_URL
# is optional; without it the URL is derived from OAUTH_CALLBACK_BASE_URL. Apple is the
# exception: it has no client secret and needs its team id, key id and private key.
# Leave commented out to disable a provider.

# Google OAuth (optional)
# OAUTH_GOOGLE_CLIENT_ID=your-google-oauth-client-id
# OAUTH_GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
# OAUTH_GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/oauth/callback/google

# Facebook OAuth (optional)
# OAUTH_FACEBOOK_CLIENT_ID=your-facebook-oauth-client-id
# OAUTH_FACEBOOK_CLIENT_SECRET=your-facebook-oauth-client-secret
# OAUTH_FACEBOOK_CALLBACK_URL=http://localhost:3000/api/auth/oauth/callback/facebook

# GitHub OAuth (optional)
# OAUTH_GITHUB_CLIENT_ID=your-github-oauth-client-id
# OAUTH_GITHUB_CLIENT_SECRET=your-github-oauth-client-secret
# OAUTH_GITHUB_CALLBACK_URL=http://localhost:3000/api/auth/oauth/callback/github

# Microsoft OAuth (optional) - see docs/setup-microsoft-oauth.md
# OAUTH_MICROSOFT_CLIENT_ID=your-entra-application-client-id
# OAUTH_MICROSOFT_CLIENT_SECRET=your-entra-client-secret
# OAUTH_MICROSOFT_CALLBACK_URL=http://localhost:5000/api/auth/oauth/microsoft/callback
# Tenant segment of the authorize and token URLs. 'common' accepts work, school
# and personal accounts; a tenant id limits sign-in to one organisation.
# OAUTH_MICROSOFT_TENANT=common

# Apple OAuth (optional) - see docs/setup-apple-oauth.md
# Apple refuses localhost redirect URIs, so this one only works behind HTTPS.
# There is no client secret: the backend signs a short lived one with the .p8 key.
# OAUTH_APPLE_CLIENT_ID=com.example.web
# OAUTH_APPLE_CALLBACK_URL=https://your-domain.com/api/auth/oauth/apple/callback
# OAUTH_APPLE_TEAM_ID=your-10-character-team-id
# OAUTH_APPLE_KEY_ID=your-10-character-key-id
# Contents of the .p8 file on one line, newlines written as \n
# OAUTH_APPLE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nMIGT...\n-----END PRIVATE KEY-----\n

# Discord OAuth (optional) - see docs/setup-discord-oauth.md
# OAUTH_DISCORD_CLIENT_ID=your-discord-application-id
# OAUTH_DISCORD_CLIENT_SECRET=your-discord-client-secret
# OAUTH_DISCORD_CALLBACK_URL=http://localhost:5000/api/auth/oauth/discord/callback

# LinkedIn OAuth (optional) - see docs/setup-linkedin-oauth.md
# Needs the "Sign In with LinkedIn using OpenID Connect" product on the app.
# OAUTH_LINKEDIN_CLIENT_ID=your-linkedin-client-id
# OAUTH_LINKEDIN_CLIENT_SECRET=your-linkedin-client-secret
# OAUTH_LINKEDIN_CALLBACK_URL=http://localhost:5000/api/auth/oauth/linkedin/callback

# Swagger API Documentation
# Enable Swagger UI (default: false)
SWAGGER_ENABLED=false

# Database Seeding (optional password overrides)
# If omitted, random base64url passwords are generated during seeding
# SEED_ADMIN_PASSWORD=your-custom-admin-password
# SEED_USER_PASSWORD=your-custom-user-password

