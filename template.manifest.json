      "requires": ["oauth-core"],
      "docs": ["docs/setup-apple-oauth.md"]
    },
    "discord": {
      "label": "Discord",
      "description": "Sign in with a Discord account.",
      "kind": "oauth",
      "default": false,
      "files": [
        "backend/src/auth/oauth/strategies/discord-oauth.strategy.ts",
        "backend/src/auth/oauth/strategies/discord-oauth.strategy.spec.ts"
      ],
      "envVars": [
        "OAUTH_DISCORD_CLIENT_ID",
