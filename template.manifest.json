    "passkeys": {
      "status": "available",
      "label": "Passkeys",
      "description": "WebAuthn sign-in with platform authenticators, and a passkey as an alternative second factor. Works on its own or next to email and password. When TOTP two-factor is also selected, its verify route accepts a passkey.",
      "kind": "passwordless",
      "default": false,
      "files": [
