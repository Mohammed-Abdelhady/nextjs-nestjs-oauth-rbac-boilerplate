{
  "version": 2,
  "$comment": "Feature map read by packages/create-nest-next-auth. Entries with \"status\": \"planned\" are not offered by the CLI. Entries with \"kind\": \"hidden\" come in through another feature's \"requires\" instead of being picked directly. Files and env vars listed here are deleted from a generated project when the feature is not selected. A path may sit under a directory another feature claims, as the provider strategies do under oauth-core; what a path may not do is belong to a feature that is still needed once this one is gone. Lines shared code needs only for one feature carry a `// feature:<id>` marker instead; see the CLI README. While native targets are planned, mobile/** stays in alwaysRemoveFiles. Remove that entry when a native target becomes available so native-core can ship its mobile workspaces.",
  "targets": {
    "web": {
      "label": "Web app (Next.js)",
      "default": true,
      "files": ["frontend/**"],
      "workspaces": ["frontend"],
      "envFiles": ["frontend/.env.example"]
    },
    "native-expo": {
      "label": "Mobile app, Expo",
      "default": false,
      "status": "planned",
      "requires": { "shared": ["native-core"], "targets": [] },
      "needsSignInSite": true
    },
    "native-cli": {
      "label": "Mobile app, React Native CLI",
      "default": false,
      "status": "planned",
      "requires": { "shared": ["native-core"] },
      "needsSignInSite": true
    }
  },
  "shared": {
    "native-core": {
      "files": ["mobile/auth/**", "mobile/device-key/**"],
      "workspaces": ["mobile/auth", "mobile/device-key"]
    }
  },
  "databases": {
    "mongodb": {
      "label": "MongoDB",
      "default": true,
      "files": ["backend/src/persistence/mongo/**", "backend/migrations/**"],
      "envVars": ["MONGO_URI"],
      "composeServices": ["mongodb"]
    },
    "postgres": {
      "label": "PostgreSQL",
      "default": false,
      "status": "planned"
    }
  },
  "options": {
    "docker": {
      "label": "Docker files",
      "default": true,
      "files": [
        "docker-compose.yml",
        "backend/Dockerfile",
        "frontend/Dockerfile",
        ".dockerignore",
        "backend/.dockerignore",
        "frontend/.dockerignore",
        ".env.docker.example",
        "scripts/config-transforms.ports.test.mjs",
        "scripts/config-transforms.docker.test.mjs",
        "scripts/lib/config-transforms.js"
      ],
      "docs": [],
      "catalogueKeys": []
    },
    "production": {
      "label": "Production nginx and compose",
      "default": true,
      "requires": ["docker"],
      "files": [
        "nginx/**",
        "docker-compose.prod.yml",
        "scripts/setup-production.js",
        "scripts/config-transforms.test.mjs",
        "scripts/config-transforms.probes.test.mjs",
        "scripts/config-transforms.diagnostics.test.mjs",
        "scripts/lib/failure-diagnostics.mjs",
        "scripts/verify-docker.mjs",
        "scripts/lib/docker-http-probes.mjs"
      ],
      "docs": ["docs/deployment.md", "docs/deployment-custom-domain.md", "docs/PRODUCTION-SETUP.md"],
      "catalogueKeys": []
    },
    "locale-ar": {
      "label": "Arabic locale",
      "default": true,
      "files": [
        "frontend/src/components/LanguageSwitcher.tsx",
        "frontend/src/components/LanguageSwitcher.test.tsx",
        "frontend/src/i18n/messages/ar.json",
        "frontend/src/i18n/messages/*.ar.json"
      ],
      "docs": [],
      "catalogueKeys": [
        {
          "path": "frontend/src/i18n/messages/en.json",
          "keys": ["common.switchToArabic"]
        }
      ]
    }
  },
  "presets": {
    "minimal": { "targets": ["web"], "features": ["email-password"], "options": [] },
    "standard": {
      "targets": ["web"],
      "features": "defaults",
      "options": ["docker", "production", "locale-ar"]
    },
    "everything": { "targets": "available", "features": "available", "options": "available" }
  },
  "features": {
    "oauth-core": {
      "label": "OAuth core",
      "description": "Provider registry, start and callback routes, account linking, profile sync. Shared by every OAuth provider.",
      "kind": "hidden",
      "default": false,
      "files": [
        "backend/src/auth/oauth/**",
        "backend/src/user/user-providers.controller.ts",
        "backend/src/user/services/account-linking.service.ts",
        "backend/src/user/services/account-linking.service.spec.ts",
        "backend/src/user/services/account-linking.queries.spec.ts",
        "backend/src/user/services/account-linking.harness-spec.ts",
        "backend/src/user/services/profile-sync.service.ts",
        "backend/src/user/services/profile-sync.service.spec.ts",
        "backend/src/user/dto/account-linking.dto.ts",
        "backend/test/constants/oauth-boot-env.ts",
        "backend/test/oauth-link.e2e-spec.ts",
        "frontend/src/modules/oauth/**",
        "frontend/src/modules/account/api/accountLinkingApi.ts",
        "frontend/src/modules/account/api/profileSyncApi.ts",
        "frontend/src/modules/account/api/__tests__/successOnlyInvalidation.test.ts",
        "frontend/src/modules/account/api/__tests__/sweepCases.ts",
        "frontend/src/modules/account/api/__tests__/sweepCoverage.test.ts",
        "frontend/src/modules/account/components/LinkedAccounts.tsx",
        "frontend/src/modules/account/components/LinkedAccountCard.tsx",
        "frontend/src/modules/account/components/LinkProviderButton.tsx",
        "frontend/src/modules/account/components/ProfileSyncStatus.tsx",
        "frontend/src/app/[locale]/(auth)/auth/oauth/**"
      ],
      "envVars": ["OAUTH_STATE_SECRET"],
      "requires": [],
      "docs": ["backend/docs/oauth-authentication.md"]
    },
    "email-password": {
      "label": "Email and password",
      "description": "Registration with a 6-digit code, login, password reset.",
      "kind": "credential",
      "default": true,
      "files": [
        "frontend/src/modules/auth/methods/password/**",
        "frontend/src/app/[locale]/(auth)/auth/register/**",
        "frontend/src/app/[locale]/(auth)/auth/forgot-password/**",
        "frontend/src/app/[locale]/(auth)/auth/reset-password/**"
      ],
      "envVars": ["SMTP_HOST", "SMTP_PORT", "SMTP_SECURE", "SMTP_USER", "SMTP_PASS", "EMAIL_FROM"],
      "requires": [],
      "docs": ["docs/setup-smtp.md", "docs/setup-smtp-mail-service.md", "docs/setup-smtp-production.md"]
    },
    "google": {
      "label": "Google",
      "description": "Sign in with a Google account.",
      "kind": "oauth",
      "default": true,
      "files": [
        "backend/src/auth/oauth/strategies/google-oauth.strategy.ts"
      ],
      "envVars": [
        "OAUTH_GOOGLE_CLIENT_ID",
        "OAUTH_GOOGLE_CLIENT_SECRET",
        "OAUTH_GOOGLE_CALLBACK_URL",
        "NEXT_PUBLIC_GOOGLE_CLIENT_ID"
      ],
      "requires": ["oauth-core"],
      "docs": ["docs/setup-google-oauth.md", "docs/setup-google-oauth-advanced-configuration.md"]
    },
    "github": {
      "label": "GitHub",
      "description": "Sign in with a GitHub account.",
      "kind": "oauth",
      "default": true,
      "files": [
        "backend/src/auth/oauth/strategies/github-oauth.strategy.ts",
        "backend/src/auth/oauth/strategies/github-oauth.strategy.spec.ts"
      ],
      "envVars": [
        "OAUTH_GITHUB_CLIENT_ID",
        "OAUTH_GITHUB_CLIENT_SECRET",
        "OAUTH_GITHUB_CALLBACK_URL",
        "NEXT_PUBLIC_GITHUB_CLIENT_ID"
      ],
      "requires": ["oauth-core"],
      "docs": ["docs/setup-github-oauth.md", "docs/setup-github-oauth-troubleshooting.md", "docs/setup-github-oauth-app-options.md"]
    },
    "facebook": {
      "label": "Facebook",
      "description": "Sign in with a Facebook account.",
      "kind": "oauth",
      "default": true,
      "files": [
        "backend/src/auth/oauth/strategies/facebook-oauth.strategy.ts"
      ],
      "envVars": [
        "OAUTH_FACEBOOK_CLIENT_ID",
        "OAUTH_FACEBOOK_CLIENT_SECRET",
        "OAUTH_FACEBOOK_CALLBACK_URL",
