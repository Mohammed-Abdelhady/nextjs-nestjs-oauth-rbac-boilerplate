    "magic-link": {
      "status": "available",
      "label": "Magic link",
      "description": "Sign in with a one-time link sent by email. Works on its own or next to email and password.",
      "kind": "passwordless",
      "default": false,
      "files": [
        "backend/src/auth/magic-link/**",
        "frontend/src/modules/auth/methods/magic-link/**",
        "frontend/src/app/[locale]/(auth)/auth/magic-link/**"
      ],
      "envVars": [
        "MAGIC_LINK_ENABLED",
        "MAGIC_LINK_EXPIRES_IN",
        "MAGIC_LINK_MAX_PER_HOUR",
        "SMTP_HOST",
        "SMTP_PORT",
        "SMTP_SECURE",
        "SMTP_USER",
        "SMTP_PASS",
        "EMAIL_FROM"
      ],
      "requires": [],
      "docs": ["docs/setup-magic-link.md"]
    },
    "totp": {
      "status": "available",
      "label": "TOTP two-factor",
      "description": "Second factor from an authenticator app, on top of password, magic link or OAuth sign-in. Includes single-use recovery codes.",
      "kind": "second-factor",
      "default": false,
      "files": [
        "backend/src/auth/two-factor/**",
        "backend/src/user/schemas/two-factor.schema.ts",
        "frontend/src/modules/two-factor/**",
        "frontend/src/lib/qr/**",
        "frontend/src/app/[locale]/(auth)/auth/2fa/**"
